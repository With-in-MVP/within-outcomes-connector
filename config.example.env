# Within Privacy Bridge configuration.
# Copy to bridge.env, fill in, and run:  docker run --env-file bridge.env <image>
# Every value stays in YOUR environment. Nothing here is ever transmitted to Within
# except the vendor slug (public) — the ingest key authenticates, the CRM
# credentials and hash secret never leave this process.

# ── CRM connection (Salesforce) ───────────────────────────────────────────
# From your Connected App / External Client App (OAuth, Client Credentials flow):
SF_INSTANCE_URL=https://your-org.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# ── CRM field mapping ─────────────────────────────────────────────────────
# Which object and fields hold your outcomes. The ID field is CRITICAL: it must
# contain the SAME identifier your MCP server's identify() callback returns
# (email, account ID, etc.) — that is what makes usage and outcomes join.
SF_OBJECT=Contact
SF_ID_FIELD=Email
SF_OUTCOME_FIELD=Outcome__c
SF_OUTCOME_DATE_FIELD=Outcome_At__c
# Optional:
#SF_PLAN_FIELD=Plan__c

# Map YOUR outcome values to Within outcome kinds ("conversion" | "churn").
# Unmapped values are skipped. Churn is counted but not yet ingested (v2).
OUTCOME_MAP={"converted":"conversion","upgraded":"conversion","churned":"churn"}

# ── Within ingestion ──────────────────────────────────────────────────────
WITHIN_INGEST_BASE_URL=https://your-within-ingest-host
WITHIN_VENDOR_SLUG=your-vendor-slug
WITHIN_INGEST_KEY=

# ── Sync behavior ─────────────────────────────────────────────────────────
# Each run re-reads records modified in the last N days and re-pushes them;
# Within deduplicates, so overlap is harmless. Schedule the bridge at any
# frequency shorter than this window (daily recommended).
LOOKBACK_DAYS=7

# ── v2 (do not set yet) ───────────────────────────────────────────────────
# Vendor-held HMAC secret. Requires a Within SDK version that supports the
# same secret on the MCP server side — setting it early will break joins.
#HASH_SECRET=

# ══════════════════════════════════════════════════════════════════════════
# ADAPTER SELECTION — which system your outcomes live in
# ══════════════════════════════════════════════════════════════════════════
# CRM=salesforce  (default; see SF_* above — zero dependencies)
# CRM=postgres    (billing tables / sanitized views; uses the `pg` driver)
#CRM=postgres

# ── Postgres adapter (CRM=postgres) ───────────────────────────────────────
# Connection string to YOUR database (read-only user recommended):
#PG_CONNECTION_STRING=postgresql://readonly_user:pass@your-db-host:5432/billing

# Mode 1 — field mapping (like Salesforce): point at a table + columns.
# PG_ID_FIELD must hold the SAME identifier your identify() returns.
#PG_TABLE=subscriptions
#PG_ID_FIELD=account_id
#PG_OUTCOME_FIELD=status
#PG_OUTCOME_DATE_FIELD=status_changed_at
#PG_PLAN_FIELD=plan_name
# Optional: enables the idempotent trailing window (recommended):
#PG_MODIFIED_FIELD=updated_at

# Mode 2 — custom SQL ("sanitized view" pattern). Overrides mode 1. Must
# return columns: raw_id, outcome, outcome_at, plan
#PG_QUERY=SELECT account_id AS raw_id, status AS outcome, status_changed_at AS outcome_at, plan_name AS plan FROM subscriptions WHERE updated_at > now() - interval '7 days'
