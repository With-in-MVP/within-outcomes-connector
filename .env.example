# Within Privacy Bridge configuration.
# Copy to bridge.env, fill in, and run:  docker run --env-file bridge.env <image>
# Every value stays in YOUR environment. Nothing here is ever transmitted to Within
# except the vendor slug (public) — the ingest key authenticates, the CRM
# credentials and hash secret never leave this process.

# ── CRM connection (Salesforce) ───────────────────────────────────────────
# From your Connected App / External Client App (OAuth, Client Credentials flow):
SF_INSTANCE_URL=https://your-org.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# ── CRM field mapping ─────────────────────────────────────────────────────
# Which object and fields hold your outcomes. The ID field is CRITICAL: it must
# contain the SAME identifier your MCP server's identify() callback returns
# (email, account ID, etc.) — that is what makes usage and outcomes join.
SF_OBJECT=Contact
SF_ID_FIELD=Email
SF_OUTCOME_FIELD=Outcome__c
SF_OUTCOME_DATE_FIELD=Outcome_At__c
# Optional:
#SF_PLAN_FIELD=Plan__c

# Map YOUR outcome values to Within outcome kinds ("conversion" | "churn").
# Unmapped values are skipped. Churn is counted but not yet ingested (v2).
OUTCOME_MAP={"converted":"conversion","upgraded":"conversion","churned":"churn"}

# ── Within ingestion ──────────────────────────────────────────────────────
# The ingest URL is built in (https://api.getwith.in) — set it only for
# testing or a dedicated Within deployment:
#WITHIN_INGEST_BASE_URL=
WITHIN_VENDOR_SLUG=your-vendor-slug
WITHIN_INGEST_KEY=

# ── Identifier normalization ──────────────────────────────────────────────
# Applied to the raw ID before hashing. MUST mirror what your MCP server's
# identify() callback does to the same identifier — the Within SDK hashes the
# userId exactly as returned (trimmed, case PRESERVED).
#   lowercase (default) — for emails, where identify() returns email.toLowerCase()
#   none                — for case-sensitive IDs (e.g. Stripe customer IDs,
#                         base62 account IDs) returned verbatim by identify()
# A mismatch here silently breaks the usage↔outcome join.
#ID_NORMALIZE=lowercase

# ── Sync behavior ─────────────────────────────────────────────────────────
# Each run re-reads records modified in the last N days and re-pushes them;
# Within deduplicates, so overlap is harmless. Schedule the bridge at any
# frequency shorter than this window (daily recommended).
LOOKBACK_DAYS=7

# ── v2 (do not set yet) ───────────────────────────────────────────────────
# Vendor-held HMAC secret. Requires a Within SDK version that supports the
# same secret on the MCP server side — setting it early will break joins.
#HASH_SECRET=

# ══════════════════════════════════════════════════════════════════════════
# ADAPTER SELECTION — which system your outcomes live in
# ══════════════════════════════════════════════════════════════════════════
# CRM=salesforce  (default; see SF_* above — zero dependencies)
# CRM=postgres    (billing tables / sanitized views; uses the `pg` driver)
#CRM=postgres

# ── Postgres adapter (CRM=postgres) ───────────────────────────────────────
# Every PG_*_FIELD value below is a COLUMN NAME IN YOUR DATABASE — the values
# shown ("subscriptions", "account_id", ...) are examples from a typical
# billing table, not names the bridge requires. Replace them with yours.
#
# Connection string to YOUR database (read-only user strongly recommended):
PG_CONNECTION_STRING=postgresql://readonly_user:pass@your-db-host:5432/yourdb

# Mode 1 — field mapping: point the bridge at a table and name your columns.
# It builds the query itself. Pick this if outcomes live in one table.

# The table holding outcome rows:
PG_TABLE=subscriptions
# The column holding the user identifier. CRITICAL: must contain the SAME
# value your MCP server's identify() returns (that is the join key):
PG_ID_FIELD=account_id
# The column holding the outcome value (mapped via OUTCOME_MAP):
PG_OUTCOME_FIELD=status
# Optional — the column saying WHEN the outcome happened:
PG_OUTCOME_DATE_FIELD=status_changed_at
# Optional — the column naming the plan/tier:
PG_PLAN_FIELD=plan_name
# Optional but recommended — a last-modified timestamp column. Enables the
# incremental window (only rows touched in the last LOOKBACK_DAYS are read);
# without it, every run reads the whole table:
PG_MODIFIED_FIELD=updated_at

# TLS: use sslmode=require in the connection string. Verification works
# automatically for AWS RDS and Supabase (their CA roots ship with the
# bridge). Only if your provider uses a different private CA: download its
# CA certificate and paste the PEM contents here:
PG_CA_CERT=

# Mode 2 — custom SQL ("sanitized view" pattern), for outcomes that need a
# join or CASE logic. If set, it overrides ALL mode 1 fields above. Your
# query must return the columns: raw_id, outcome, outcome_at, plan.
# raw_id is your identifier as stored — it is hashed inside this process and
# discarded; only the hash leaves your environment. Best practice: wrap the
# logic in a database VIEW, grant the bridge's read-only user access to only
# that view, and select from it, e.g.:
#   SELECT account_id AS raw_id, status AS outcome, status_changed_at AS outcome_at, plan_name AS plan FROM v_outcomes
PG_QUERY=
